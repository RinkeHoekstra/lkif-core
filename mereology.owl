    <owl:imports rdf:resource="http://www.estrellaproject.org/lkif-core/lkif-top.owl"/>
    <dct:license rdf:resource="https://creativecommons.org/licenses/by/4.0/"/>
  </owl:Ontology>
  <owl:Class rdf:about="http://www.estrellaproject.org/lkif-core/mereology.owl#Atom">
    <rdfs:subClassOf rdf:resource="http://www.estrellaproject.org/lkif-core/lkif-top.owl#Abstract_Entity"/>
    <owl:disjointWith rdf:resource="http://www.estrellaproject.org/lkif-core/mereology.owl#Whole"/>
    <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">An atom has no parts</rdfs:comment>
  </owl:Class>
  <owl:ObjectProperty rdf:about="http://www.estrellaproject.org/lkif-core/mereology.owl#direct_part">
    <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The non-transitive part relation.</rdfs:comment>
    <owl:inverseOf>
      <owl:ObjectProperty rdf:about="http://www.estrellaproject.org/lkif-core/mereology.owl#direct_part_of">
        <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The non-transitive part_of relation</rdfs:comment>
        <rdfs:subPropertyOf rdf:resource="http://www.estrellaproject.org/lkif-core/mereology.owl#part_of"/>
        <owl:equivalentProperty rdf:resource="http://www.estrellaproject.org/lkif-core/mereology.owl#strict_part_of"/>
      </owl:ObjectProperty>
    </owl:inverseOf>
    <rdfs:subPropertyOf>
      <owl:ObjectProperty rdf:about="http://www.estrellaproject.org/lkif-core/mereology.owl#part">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
        <rdfs:comment>Transitive part relation</rdfs:comment>
      </owl:ObjectProperty>
    </rdfs:subPropertyOf>
    <owl:equivalentProperty>
      <owl:ObjectProperty rdf:about="http://www.estrellaproject.org/lkif-core/mereology.owl#strict_part">
        <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Non transitive part relation</rdfs:comment>
        <rdfs:subPropertyOf rdf:resource="http://www.estrellaproject.org/lkif-core/mereology.owl#part"/>
      </owl:ObjectProperty>
    </owl:equivalentProperty>
  </owl:ObjectProperty>
  <owl:Class rdf:about="http://www.estrellaproject.org/lkif-core/mereology.owl#Pair">
    <rdfs:subClassOf rdf:resource="http://www.estrellaproject.org/lkif-core/mereology.owl#Composition"/>
    <rdfs:subClassOf>
      <owl:Restriction rdf:nodeID="Na85e58c1b79041668fb228faadafeed7">
        <owl:onProperty rdf:resource="http://www.estrellaproject.org/lkif-core/mereology.owl#strict_part"/>
        <owl:onClass rdf:resource="http://www.estrellaproject.org/lkif-core/mereology.owl#Part"/>
        <owl:cardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">2</owl:cardinality>
      </owl:Restriction>
    </rdfs:subClassOf>
    <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A composition of exactly two parts</rdfs:comment>
  </owl:Class>
  <owl:ObjectProperty rdf:about="http://www.estrellaproject.org/lkif-core/mereology.owl#member">
    <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Specifies membership of a set or group</rdfs:comment>
    <owl:inverseOf>
      <owl:ObjectProperty rdf:about="http://www.estrellaproject.org/lkif-core/mereology.owl#member_of">
        <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Specifies membership of a set or group</rdfs:comment>
        <rdfs:subPropertyOf rdf:resource="http://www.estrellaproject.org/lkif-core/mereology.owl#strict_part_of"/>
      </owl:ObjectProperty>
    </owl:inverseOf>
    <rdfs:subPropertyOf rdf:resource="http://www.estrellaproject.org/lkif-core/mereology.owl#strict_part"/>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://www.estrellaproject.org/lkif-core/mereology.owl#composed_of">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
    <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Specifies that some thing is composed_of (spatially) within some other thing</rdfs:comment>
    <owl:inverseOf>
      <owl:ObjectProperty rdf:about="http://www.estrellaproject.org/lkif-core/mereology.owl#composes">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
        <rdfs:comment>Specifies that some thing is composed_of (spatially) within some other thing</rdfs:comment>
        <rdfs:subPropertyOf rdf:resource="http://www.estrellaproject.org/lkif-core/mereology.owl#part_of"/>
      </owl:ObjectProperty>
    </owl:inverseOf>
    <rdfs:subPropertyOf rdf:resource="http://www.estrellaproject.org/lkif-core/mereology.owl#part"/>
  </owl:ObjectProperty>
  <owl:AnnotationProperty rdf:about="http://www.w3.org/2002/07/owl#versionInfo"/>
  <owl:ObjectProperty rdf:about="http://www.estrellaproject.org/lkif-core/mereology.owl#contains">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
    <rdfs:comment>Specifies that some thing is contained (spatially) within some other thing</rdfs:comment>
    <owl:inverseOf>
      <owl:ObjectProperty rdf:about="http://www.estrellaproject.org/lkif-core/mereology.owl#contained_in">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
        <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Specifies that some thing is contained (spatially) within some other thing</rdfs:comment>
        <rdfs:subPropertyOf rdf:resource="http://www.estrellaproject.org/lkif-core/mereology.owl#part_of"/>
      </owl:ObjectProperty>
    </owl:inverseOf>
    <rdfs:subPropertyOf rdf:resource="http://www.estrellaproject.org/lkif-core/mereology.owl#part"/>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://www.estrellaproject.org/lkif-core/mereology.owl#component_of">
    <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Specifies that some thing is a (functional) component of some other thing</rdfs:comment>
    <owl:inverseOf>
      <owl:ObjectProperty rdf:about="http://www.estrellaproject.org/lkif-core/mereology.owl#component">
        <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Specifies that some thing is a (functional) component of some other thing</rdfs:comment>
        <rdfs:subPropertyOf rdf:resource="http://www.estrellaproject.org/lkif-core/mereology.owl#strict_part"/>
      </owl:ObjectProperty>
    </owl:inverseOf>
    <rdfs:subPropertyOf>
      <owl:ObjectProperty rdf:about="http://www.estrellaproject.org/lkif-core/mereology.owl#strict_part_of">
        <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Non transitive part_of relation</rdfs:comment>
        <rdfs:subPropertyOf rdf:resource="http://www.estrellaproject.org/lkif-core/mereology.owl#part_of"/>
        <owl:inverseOf rdf:resource="http://www.estrellaproject.org/lkif-core/mereology.owl#strict_part"/>
      </owl:ObjectProperty>
    </rdfs:subPropertyOf>
  </owl:ObjectProperty>
  <owl:AnnotationProperty rdf:about="http://www.w3.org/2000/01/rdf-schema#comment"/>
  <owl:Class rdf:about="http://www.estrellaproject.org/lkif-core/mereology.owl#Whole">
    <owl:equivalentClass>
      <owl:Restriction rdf:nodeID="N70c1abcb76a346a7a1d0d95b601d497d">
        <owl:onProperty rdf:resource="http://www.estrellaproject.org/lkif-core/mereology.owl#strict_part"/>
        <owl:someValuesFrom rdf:resource="http://www.estrellaproject.org/lkif-core/mereology.owl#Part"/>
      </owl:Restriction>
    </owl:equivalentClass>
    <rdfs:subClassOf rdf:resource="http://www.estrellaproject.org/lkif-core/lkif-top.owl#Abstract_Entity"/>
    <rdfs:subClassOf>
      <owl:Restriction rdf:nodeID="N53711a7363964762b4f628449264db15">
        <owl:onProperty rdf:resource="http://www.estrellaproject.org/lkif-core/mereology.owl#strict_part"/>
        <owl:allValuesFrom rdf:resource="http://www.estrellaproject.org/lkif-core/mereology.owl#Part"/>
      </owl:Restriction>
    </rdfs:subClassOf>
    <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A whole has at least some part</rdfs:comment>
  </owl:Class>
  <owl:ObjectProperty rdf:about="http://www.estrellaproject.org/lkif-core/mereology.owl#part_of">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
    <rdfs:comment>Transitive part_of relation</rdfs:comment>
    <owl:inverseOf rdf:resource="http://www.estrellaproject.org/lkif-core/mereology.owl#part"/>
  </owl:ObjectProperty>
  <owl:Class rdf:about="http://www.estrellaproject.org/lkif-core/lkif-top.owl#Abstract_Entity"/>
  <owl:Class rdf:about="http://www.estrellaproject.org/lkif-core/mereology.owl#Part">
    <owl:equivalentClass>
      <owl:Restriction rdf:nodeID="Nd55c4dc5080b414380984894474fd8e2">
        <owl:onProperty rdf:resource="http://www.estrellaproject.org/lkif-core/mereology.owl#strict_part_of"/>
        <owl:someValuesFrom rdf:resource="http://www.estrellaproject.org/lkif-core/mereology.owl#Whole"/>
      </owl:Restriction>
    </owl:equivalentClass>
    <rdfs:subClassOf rdf:resource="http://www.estrellaproject.org/lkif-core/lkif-top.owl#Abstract_Entity"/>
    <rdfs:subClassOf>
      <owl:Restriction rdf:nodeID="N78b26ce2ed97411fb1383e2278bb16a3">
        <owl:onProperty rdf:resource="http://www.estrellaproject.org/lkif-core/mereology.owl#strict_part_of"/>
        <owl:allValuesFrom rdf:resource="http://www.estrellaproject.org/lkif-core/mereology.owl#Whole"/>
      </owl:Restriction>
    </rdfs:subClassOf>
    <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A part is a part_of some whole</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="http://www.estrellaproject.org/lkif-core/mereology.owl#Composition">
    <rdfs:subClassOf rdf:resource="http://www.estrellaproject.org/lkif-core/mereology.owl#Whole"/>
    <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A composition has multiple parts, the components should meet</rdfs:comment>
  </owl:Class>
</rdf:RDF>
