<?xml version="1.0" encoding="utf-8"?>
<rdf:RDF
  xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
  xmlns:owl="http://www.w3.org/2002/07/owl#"
  xmlns:dct="http://purl.org/dc/terms/"
  xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
>
  <owl:ObjectProperty rdf:about="http://www.estrellaproject.org/lkif-core/lkif-rules.owl#excluded">
    <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Specifies an exclusion relation between a rule and an atom</rdfs:comment>
    <rdfs:range>
      <owl:Restriction rdf:nodeID="N74afbec9e1754db3aae204fe57a7c859">
        <owl:someValuesFrom rdf:resource="http://www.estrellaproject.org/lkif-core/lkif-rules.owl#Atom"/>
        <owl:onProperty rdf:resource="http://www.estrellaproject.org/lkif-core/role.owl#plays"/>
      </owl:Restriction>
    </rdfs:range>
    <rdfs:subPropertyOf>
      <owl:ObjectProperty rdf:about="http://www.estrellaproject.org/lkif-core/lkif-rules.owl#rule_predicate">
        <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Some predicate in or over some rule</rdfs:comment>
        <rdfs:range>
          <owl:Restriction rdf:nodeID="Nb3508aa54d294395b83efc510e49eb8b">
            <owl:someValuesFrom>
              <owl:Class rdf:nodeID="N950f2d42163a4be4a42f255f2a6ff331">
                <owl:unionOf rdf:parseType="Collection">
                  <rdf:Description rdf:about="http://www.estrellaproject.org/lkif-core/lkif-rules.owl#Atom"/>
                  <rdf:Description rdf:about="http://www.estrellaproject.org/lkif-core/lkif-rules.owl#Rule"/>
                </owl:unionOf>
              </owl:Class>
            </owl:someValuesFrom>
            <owl:onProperty rdf:resource="http://www.estrellaproject.org/lkif-core/role.owl#plays"/>
          </owl:Restriction>
        </rdfs:range>
        <rdfs:domain>
          <owl:Restriction rdf:nodeID="N59991062b99d426e994b3bdc2de6f69a">
            <owl:someValuesFrom rdf:resource="http://www.estrellaproject.org/lkif-core/lkif-rules.owl#Rule"/>
            <owl:onProperty rdf:resource="http://www.estrellaproject.org/lkif-core/role.owl#plays"/>
          </owl:Restriction>
        </rdfs:domain>
      </owl:ObjectProperty>
    </rdfs:subPropertyOf>
  </owl:ObjectProperty>
  <owl:Ontology rdf:about="http://www.estrellaproject.org/lkif-core/lkif-rules.owl">
    <owl:imports rdf:resource="http://www.estrellaproject.org/lkif-core/expression.owl"/>
    <owl:versionInfo rdf:datatype="http://www.w3.org/2001/XMLSchema#string">
	This module is part of LKIF-Core, version 1.1, part of Deliverable 1.4 of ESTRELLA, IST-2004-027665
	</owl:versionInfo>
    <owl:versionInfo rdf:datatype="http://www.w3.org/2001/XMLSchema#string">
	LKIF Core, version 1.1, copyright (C) 2008, the ESTRELLA consortium
	</owl:versionInfo>
    <owl:versionInfo rdf:datatype="http://www.w3.org/2001/XMLSchema#string">
	Partner contributions from the University of Amsterdam (UvA) and the Fraunhofer institute (FOKUS).

	Editor:       Rinke Hoekstra (UvA)
	Authors:      Rinke Hoekstra (UvA), Thomas Gordon (FOKUS)
	</owl:versionInfo>
    <owl:versionInfo xml:lang="en">The LKIF-Core ontology, version 1.0, is part of Deliverable 1.4 of the European project for Standardised Transparent Representations in order to Extend Legal Accessibility (ESTRELLA, IST-2004-027665), http://www.estrellaproject.org

This ontology is licensed under the Creative Commons Attribution 4.0 International License (CC BY 4.0). To view a copy of this license, visit https://creativecommons.org/licenses/by/4.0/</owl:versionInfo>
    <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">
	This ontology describes the classes and properties used in the LKIF rules language, as specified in Deliverable 1.1. Please note that the definition of SWRL rules is not imported into this ontology. This extension will be realised through an argumentation rules framework.
	</rdfs:comment>
    <dct:license rdf:resource="https://creativecommons.org/licenses/by/4.0/"/>
  </owl:Ontology>
  <owl:Class rdf:about="http://www.estrellaproject.org/lkif-core/lkif-rules.owl#Negated_Atom">
    <rdfs:subClassOf>
      <owl:Restriction rdf:nodeID="N8946fa2be55b4498a7a01dd5399f25f5">
        <owl:onProperty rdf:resource="http://www.estrellaproject.org/lkif-core/role.owl#played_by"/>
        <owl:allValuesFrom rdf:resource="http://www.estrellaproject.org/lkif-core/mereology.owl#Atom"/>
      </owl:Restriction>
    </rdfs:subClassOf>
    <rdfs:subClassOf>
      <owl:Restriction rdf:nodeID="Nfcb3bf85294e4c06bad93d4f08f934f1">
        <owl:onProperty rdf:resource="http://www.estrellaproject.org/lkif-core/role.owl#played_by"/>
        <owl:someValuesFrom>
          <owl:Class rdf:nodeID="N10226be020f141159f4f844dab1d431c">
            <owl:intersectionOf rdf:parseType="Collection">
              <rdf:Description rdf:about="http://www.estrellaproject.org/lkif-core/expression.owl#Expression"/>
              <rdf:Description rdf:about="http://www.estrellaproject.org/lkif-core/mereology.owl#Atom"/>
            </owl:intersectionOf>
          </owl:Class>
        </owl:someValuesFrom>
      </owl:Restriction>
    </rdfs:subClassOf>
    <rdfs:subClassOf rdf:resource="http://www.estrellaproject.org/lkif-core/role.owl#Epistemic_Role"/>
    <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A negated atom is the negation of some other atom (cf. Deliverable 1.1)</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="http://www.estrellaproject.org/lkif-core/lkif-rules.owl#Valid_Rule">
    <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A valid LKIF rule</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://www.estrellaproject.org/lkif-core/lkif-rules.owl#Rule"/>
  </owl:Class>
  <owl:Class rdf:about="http://www.estrellaproject.org/lkif-core/lkif-rules.owl#Argument">
    <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">An argument is some rule used in argumentation (cf. Deliverable 1.1)</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://www.estrellaproject.org/lkif-core/expression.owl#Argument"/>
    <rdfs:subClassOf rdf:resource="http://www.estrellaproject.org/lkif-core/lkif-rules.owl#Rule"/>
  </owl:Class>
  <owl:Class rdf:about="http://www.estrellaproject.org/lkif-core/lkif-rules.owl#Assumption">
    <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">An assumption is some atom held to be true, without proof, in the head of a rule (defeasibly), cf. Deliverable 1.1</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://www.estrellaproject.org/lkif-core/lkif-rules.owl#Atom"/>
    <rdfs:subClassOf rdf:resource="http://www.estrellaproject.org/lkif-core/expression.owl#Assumption"/>
  </owl:Class>
  <owl:ObjectProperty rdf:about="http://www.estrellaproject.org/lkif-core/lkif-rules.owl#applies">
    <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Specifies whether some rule applies to some atom</rdfs:comment>
    <rdfs:range>
      <owl:Restriction rdf:nodeID="N1ca28e6ab74d430f97ab7450add66fc2">
        <owl:someValuesFrom rdf:resource="http://www.estrellaproject.org/lkif-core/lkif-rules.owl#Atom"/>
        <owl:onProperty rdf:resource="http://www.estrellaproject.org/lkif-core/role.owl#plays"/>
      </owl:Restriction>
    </rdfs:range>
    <rdfs:subPropertyOf rdf:resource="http://www.estrellaproject.org/lkif-core/lkif-rules.owl#rule_predicate"/>
  </owl:ObjectProperty>
  <owl:Class rdf:about="http://www.estrellaproject.org/lkif-core/lkif-rules.owl#Exception">
    <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">An exception states an exception to the head of the rule (defeasibly), cf. Deliverable 1.1</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://www.estrellaproject.org/lkif-core/lkif-rules.owl#Atom"/>
    <rdfs:subClassOf rdf:resource="http://www.estrellaproject.org/lkif-core/expression.owl#Exception"/>
  </owl:Class>
  <owl:ObjectProperty rdf:about="http://www.estrellaproject.org/lkif-core/lkif-rules.owl#rebuts">
    <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Specifies whether some rule abuts another rule</rdfs:comment>
    <rdfs:range>
      <owl:Restriction rdf:nodeID="N3d52aad9b136433ca2722e9ff8b7bab6">
        <owl:someValuesFrom rdf:resource="http://www.estrellaproject.org/lkif-core/lkif-rules.owl#Rule"/>
        <owl:onProperty rdf:resource="http://www.estrellaproject.org/lkif-core/role.owl#plays"/>
      </owl:Restriction>
    </rdfs:range>
    <rdfs:subPropertyOf rdf:resource="http://www.estrellaproject.org/lkif-core/lkif-rules.owl#rule_predicate"/>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://www.estrellaproject.org/lkif-core/lkif-rules.owl#prior">
    <rdfs:range>
      <owl:Restriction rdf:nodeID="Nc707cc918d0748198c43ecef69661df9">
        <owl:someValuesFrom rdf:resource="http://www.estrellaproject.org/lkif-core/lkif-rules.owl#Rule"/>
        <owl:onProperty rdf:resource="http://www.estrellaproject.org/lkif-core/role.owl#plays"/>
      </owl:Restriction>
    </rdfs:range>
    <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Specifies a prior relation between two rules</rdfs:comment>
    <rdfs:subPropertyOf rdf:resource="http://www.estrellaproject.org/lkif-core/lkif-rules.owl#rule_predicate"/>
  </owl:ObjectProperty>
  <owl:Class rdf:about="http://www.estrellaproject.org/lkif-core/lkif-rules.owl#Atom">
    <rdfs:subClassOf>
      <owl:Restriction rdf:nodeID="N88a0511c314a46a4bdd030af25d2e2dd">
        <owl:onProperty rdf:resource="http://www.estrellaproject.org/lkif-core/role.owl#played_by"/>
        <owl:allValuesFrom rdf:resource="http://www.estrellaproject.org/lkif-core/mereology.owl#Atom"/>
      </owl:Restriction>
    </rdfs:subClassOf>
    <rdfs:subClassOf>
      <owl:Restriction rdf:nodeID="Nec1bc27c6ed74e3caf5fc01d8b57c8a8">
        <owl:onProperty rdf:resource="http://www.estrellaproject.org/lkif-core/role.owl#played_by"/>
        <owl:someValuesFrom>
          <owl:Class rdf:nodeID="N6affd4db02674410a1f12c4c55eb30f0">
            <owl:intersectionOf rdf:parseType="Collection">
              <rdf:Description rdf:about="http://www.estrellaproject.org/lkif-core/expression.owl#Expression"/>
              <rdf:Description rdf:about="http://www.estrellaproject.org/lkif-core/mereology.owl#Atom"/>
            </owl:intersectionOf>
          </owl:Class>
        </owl:someValuesFrom>
      </owl:Restriction>
    </rdfs:subClassOf>
    <rdfs:subClassOf rdf:resource="http://www.estrellaproject.org/lkif-core/role.owl#Epistemic_Role"/>
    <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">An atom is the most basic (undivisible) part of an LKIF rule (cf. Deliverable 1.1)</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="http://www.estrellaproject.org/lkif-core/lkif-rules.owl#Rule">
    <rdfs:subClassOf>
      <owl:Restriction rdf:nodeID="N60071d556d324cfb998b1a89771042a4">
        <owl:allValuesFrom rdf:resource="http://www.estrellaproject.org/lkif-core/mereology.owl#Composition"/>
        <owl:onProperty rdf:resource="http://www.estrellaproject.org/lkif-core/role.owl#played_by"/>
      </owl:Restriction>
    </rdfs:subClassOf>
    <rdfs:subClassOf>
      <owl:Restriction rdf:nodeID="Nd701efe6ccb040dc853e29132280861a">
        <owl:onProperty rdf:resource="http://www.estrellaproject.org/lkif-core/role.owl#played_by"/>
        <owl:someValuesFrom>
          <owl:Class rdf:nodeID="N921f3dc65b304f018c8a2a41992f7e2d">
            <owl:intersectionOf rdf:parseType="Collection">
              <rdf:Description rdf:about="http://www.estrellaproject.org/lkif-core/expression.owl#Expression"/>
              <rdf:Description rdf:about="http://www.estrellaproject.org/lkif-core/mereology.owl#Composition"/>
            </owl:intersectionOf>
          </owl:Class>
        </owl:someValuesFrom>
      </owl:Restriction>
    </rdfs:subClassOf>
    <rdfs:subClassOf rdf:resource="http://www.estrellaproject.org/lkif-core/role.owl#Epistemic_Role"/>
    <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">An LKIF rule, based on swrl:Impl</rdfs:comment>
  </owl:Class>
</rdf:RDF>
